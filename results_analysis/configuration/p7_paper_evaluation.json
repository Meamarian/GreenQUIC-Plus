{
  "schema": "greenquic.paper-evaluation.p7.v1",
  "scope": "Final Linux baseline configuration used for GreenQUIC+ paper evaluation; not TUM provisioning/setup defaults",
  "evaluation_profile": "P7 paper Linux baseline",
  "workload": {
    "runs": 6,
    "downloads_per_run": 5,
    "payload_bytes_per_download": 8589934592,
    "request_path": "/file_8G.bin",
    "connection_model": "five sequential downloads in one QUIC connection",
    "gap_seconds": 5,
    "pre_cooldown_seconds": 5,
    "post_cooldown_seconds": 5,
    "between_runs_seconds": 5,
    "execution_profile": "max_throughput",
    "chart_style": "both",
    "log_level": 0
  },
  "build": {
    "source_tree": "isolated msquic-p7-linux-source",
    "build_dir": "msquic/build-linux-p7",
    "cmake_build_type": "Release",
    "tls": "openssl",
    "build_shared": false,
    "build_tools": true,
    "build_tests": false,
    "build_perf": false,
    "dpdk_enabled": false,
    "xdp_enabled": false,
    "datapath": "normal Linux UDP socket path (datapath_linux.c + datapath_epoll.c)"
  },
  "network": {
    "server_host": "idex",
    "client_host": "tinyman",
    "server_ip": "192.168.100.1",
    "client_ip": "192.168.100.2",
    "prefix_len": 24,
    "port": 4433,
    "test_nic_pci": "0000:18:00.0",
    "mtu": 1500,
    "udp_socket_buffers_bytes": {
      "net.core.rmem_default": 6815744,
      "net.core.rmem_max": 6815744,
      "net.core.wmem_default": 6815744,
      "net.core.wmem_max": 6815744
    },
    "combined_channels": 1,
    "disable_rps": true,
    "disable_rdma_aux_for_test_nic": true,
    "network_diagnostics": false,
    "nic_offload_profile": {
      "requested": "paper",
      "underlying_profile": "native + explicit paper-style offload sequence",
      "required_on": [
        "tso",
        "gso",
        "tx-checksumming",
        "gro"
      ],
      "best_effort_on": [
        "tx-udp-segmentation",
        "rx-checksumming",
        "rx-gro-hw"
      ]
    }
  },
  "cpu_topology": {
    "dataplane_cpu": 19,
    "dataplane_role": "NIC IRQ/NAPI/softirq target",
    "quic_worker_cpus": [21, 22, 23, 24],
    "pin_irq": true,
    "pin_quic": true,
    "stop_irqbalance": true,
    "record_quic_cpus": false,
    "recorded_frequency_cstate_cpu": 19
  },
  "recording": {
    "enable_record": true,
    "rapl_interval_ms": 6,
    "rapl_smooth_samples": 3,
    "frequency_interval_ms": 1,
    "require_rapl": true,
    "record_cpu": 19,
    "record_quic_cpus": false,
    "recorder_cpu": "auto"
  },
  "lifecycle": {
    "temporarily_bind_test_nic_to_linux_ice_for_p7": true,
    "restore_exact_pre_p7_dpdk_driver_after_run": true,
    "restore_dpdk": 1
  },
  "source_anchors": [
    "greenquic_test_suite_v22/test_cases/pretests/P7_linux_udp_baseline/config.env",
    "greenquic_test_suite_v22/test_cases/pretests/P7_linux_udp_baseline/run_matrix_from_idex.sh",
    "greenquic_test_suite_v22/test_cases/pretests/P7_linux_udp_baseline/run_matrix_with_report.sh",
    "greenquic_test_suite_v22/test_cases/pretests/P7_linux_udp_baseline/p7_network_tuning.sh",
    "greenquic_test_suite_v22/test_cases/pretests/P7_linux_udp_baseline/build_p7_linux.sh"
  ]
}
