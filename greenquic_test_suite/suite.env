# GreenQUIC test-suite global configuration.
# Paths may be absolute or relative to SUITE_ROOT.

MSQUIC_DIR="/root/mohsen/msquic"
DPDK_DIR="/root/mohsen/msquic/deps/dpdk"

# Override these when automatic binary detection finds the wrong build.
GQ_INTEROP_SERVER_BIN="/root/mohsen/msquic/build-greenquic/bin/Release/quicinteropserver"
GQ_INTEROP_CLIENT_BIN="/root/mohsen/msquic/build-greenquic/bin/Release/quicinterop"
GQ_SECNETPERF_BIN=""

SERVER_HOST="192.168.100.1"
SERVER_LISTEN="*"
SERVER_PORT="4433"
CLIENT_TIMEOUT_MS="${CLIENT_TIMEOUT_MS:-120000}"

# Host and raw-DPDK endpoint identity.
SERVER_NAME="idex"
CLIENT_NAME="tinyman"
SERVER_LOCAL_IP="192.168.100.1"
CLIENT_LOCAL_IP="192.168.100.2"
SERVER_LOCAL_MAC="6c:fe:54:59:98:b0"
CLIENT_LOCAL_MAC="6c:fe:54:59:99:38"
SERVER_PEER_MAC="6c:fe:54:59:99:38"
CLIENT_PEER_MAC="6c:fe:54:59:98:b0"

# Required for the raw DPDK datapath. Set independently on server and client.
SERVER_DPDK_DEVICE="0000:18:00.0"
CLIENT_DPDK_DEVICE="0000:18:00.0"

SERVER_DPDK_LCORES="19,20"
CLIENT_DPDK_LCORES="19,20"
SERVER_QUIC_CPUS="21,22,23,24"
CLIENT_QUIC_CPUS="21,22,23,24"
SERVER_PARTITION_MAP="0:19,1:19,2:20,3:20"
CLIENT_PARTITION_MAP="0:19,1:19,2:20,3:20"
SERVER_TX_OWNER_LCORE="19"
CLIENT_TX_OWNER_LCORE="19"

# This package is intended for the GreenQUIC multicore campaign.
# Individual runs may still override it with ENABLE_MULTICORE=0.
ENABLE_MULTICORE="1"

# With two lcores this must remain 1 to provide two RX/RSS queues while lcore 8/12
# remains the sole TX-ring consumer. Set 0 only when at least one additional RX lcore exists.
GREENQUIC_TX_OWNER_ALSO_RX="1"

# Optional override. Detection otherwise searches DPDK build/install trees.
GREENQUIC_DPDK_DRIVER_PATH="${GREENQUIC_DPDK_DRIVER_PATH:-}"

# Logging changes power and timing. Keep 0 for final energy runs.
GQ_LOG_LEVEL="1"
GQ_STATS_PERIOD_US="1000000"

# Set to 1 only when deliberately accepting process-launch approximation for
# sub-millisecond connection/batch gaps.
ALLOW_APPROX_MICRO_GAPS="${ALLOW_APPROX_MICRO_GAPS:-0}"

# Set to 1 only when you deliberately want to run binaries for which the
# GreenQuicQuicWorkerCpus / GreenQuicProfile integration cannot be verified.
ALLOW_UNVERIFIED_MSQUIC_CONFIG="${ALLOW_UNVERIFIED_MSQUIC_CONFIG:-0}"

# Optional exact in-process workload client. Expected interface is documented
# in common/INPROCESS_CLIENT_INTERFACE.txt.
INPROCESS_CLIENT_BIN="${INPROCESS_CLIENT_BIN:-}"



# Energy runs fail when no package RAPL counter is readable. Set 0 only for syntax/orchestration dry runs.
GQ_REQUIRE_RAPL="0"

# Server RAPL starts before the persistent listener and ends on Ctrl+C. Its joules are not a
# transfer-window measurement unless both hosts are externally synchronized.
GQ_ALLOW_UNALIGNED_SERVER_ENERGY="${GQ_ALLOW_UNALIGNED_SERVER_ENERGY:-0}"

# T8 is invalid without externally configured loss (for example tc/netem).
# Set to 1 only after the impairment is active and independently verified.
GQ_LOSS_INJECTION_CONFIRMED="${GQ_LOSS_INJECTION_CONFIRMED:-0}"

# V21 selectable idle-mode overrides. Leave empty to use each testcase's default.
# Supported values: off, short, pause, monitor, epoll, auto.
GQ_IDLE_MODE_OVERRIDE="${GQ_IDLE_MODE_OVERRIDE:-}"
# Supported fallback values: short, off, fail.
GQ_IDLE_FALLBACK_OVERRIDE="${GQ_IDLE_FALLBACK_OVERRIDE:-}"

# Dedicated V21 diagnostic cases set TEST_GQ_LOG_LEVEL/TEST_GQ_STATS_PERIOD_US.
# Set VALIDATE_IDLE_EVIDENCE=0 only for exploratory mode matrices; the dedicated
# default run must keep evidence validation enabled.
VALIDATE_IDLE_EVIDENCE="${VALIDATE_IDLE_EVIDENCE:-}"
