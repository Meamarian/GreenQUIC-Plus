#!/usr/bin/env python3
"""Create CPU-frequency traces from timestamped GreenQUIC log lines."""
from __future__ import annotations

import argparse
import csv
import html
import json
import math
import os
import re
from pathlib import Path
from types import SimpleNamespace
from typing import Any

from gq_plot import settings

CPU_RE = re.compile(r"^\[CPU\s+(\d+)\]")
ACTION_RE = re.compile(r"\bpolicy_action=([^\s]+).*?\bafter_khz=(\d+)")
STATS_RE = re.compile(r"\bfreq_khz=(\d+)")


def read_events(path: Path) -> tuple[list[dict[str, Any]], float]:
    events: list[dict[str, Any]] = []
    duration_s = 0.0
    for raw in path.read_text(encoding="utf-8", errors="replace").splitlines():
        try:
            row = json.loads(raw)
        except json.JSONDecodeError:
            continue
        if row.get("type") != "line":
            continue
        elapsed_s = float(row.get("elapsed_s", 0.0))
        duration_s = max(duration_s, elapsed_s)
        line = str(row.get("line", ""))
        cpu_match = CPU_RE.search(line)
        if not cpu_match:
            continue
        cpu = int(cpu_match.group(1))
        action_match = ACTION_RE.search(line)
        stats_match = STATS_RE.search(line)
        if action_match:
            events.append({
                "elapsed_s": elapsed_s,
                "elapsed_ms": elapsed_s * 1000.0,
                "cpu": cpu,
                "freq_khz": int(action_match.group(2)),
                "source": "frequency_action",
                "action": action_match.group(1),
            })
        elif stats_match:
            events.append({
                "elapsed_s": elapsed_s,
                "elapsed_ms": elapsed_s * 1000.0,
                "cpu": cpu,
                "freq_khz": int(stats_match.group(1)),
                "source": "periodic_stats",
                "action": None,
            })
    return events, duration_s


def deduplicate(events: list[dict[str, Any]]) -> list[dict[str, Any]]:
    result: list[dict[str, Any]] = []
    last_by_cpu: dict[int, int] = {}
    for event in events:
        cpu = int(event["cpu"])
        freq = int(event["freq_khz"])
        if last_by_cpu.get(cpu) == freq:
            continue
        result.append(event)
        last_by_cpu[cpu] = freq
    return result


# GREENQUIC-V22-FREQUENCY-BAR-TIMELINE-V1

def _env_int(name: str, default: int, minimum: int, maximum: int) -> int:
    raw = os.environ.get(name)
    if raw is None or raw.strip() == "":
        return default
    try:
        value = int(raw)
    except ValueError:
        return default
    return min(max(value, minimum), maximum)


def _nice_step(duration_ms: float, requested_ms: int, max_ticks: int) -> float:
    if duration_ms <= 0.0:
        return float(max(1, requested_ms))

    minimum = max(float(requested_ms), duration_ms / max(1, max_ticks))
    exponent = math.floor(math.log10(minimum))
    base = 10.0 ** exponent

    for factor in (1.0, 2.0, 5.0, 10.0):
        candidate = factor * base
        if candidate >= minimum:
            return candidate

    return 10.0 * base


def _frequency_intervals(
    events: list[dict[str, Any]],
    duration_ms: float,
) -> dict[int, list[dict[str, Any]]]:
    by_cpu: dict[int, list[dict[str, Any]]] = {}

    for event in events:
        by_cpu.setdefault(int(event["cpu"]), []).append(event)

    result: dict[int, list[dict[str, Any]]] = {}

    for cpu, rows in by_cpu.items():
        rows.sort(key=lambda row: float(row["elapsed_ms"]))
        intervals: list[dict[str, Any]] = []

        for index, row in enumerate(rows):
            start_ms = max(0.0, float(row["elapsed_ms"]))
            end_ms = (
                float(rows[index + 1]["elapsed_ms"])
                if index + 1 < len(rows)
                else max(duration_ms, start_ms)
            )

            if end_ms <= start_ms:
                continue

            intervals.append({
                "cpu": cpu,
                "start_ms": start_ms,
                "end_ms": end_ms,
                "duration_ms": end_ms - start_ms,
                "freq_khz": int(row["freq_khz"]),
                "freq_ghz": int(row["freq_khz"]) / 1_000_000.0,
                "action": row.get("action"),
                "source": row.get("source"),
            })

        result[cpu] = intervals

    return result


def _write_frequency_bar_svg(
    path: Path,
    *,
    role: str,
    events: list[dict[str, Any]],
    duration_ms: float,
):
    base = settings("freq", duration_ms)
    intervals_by_cpu = _frequency_intervals(events, duration_ms)
    cpus = sorted(intervals_by_cpu)

    max_x_ms = max(
        [duration_ms, 1.0]
        + [
            float(interval["end_ms"])
            for rows in intervals_by_cpu.values()
            for interval in rows
        ]
    )
    max_freq_ghz = max(
        [
            float(interval["freq_ghz"])
            for rows in intervals_by_cpu.values()
            for interval in rows
        ],
        default=1.0,
    )
    y_max = max(1.0, math.ceil(max_freq_ghz * 10.0) / 10.0) * 1.08

    left = 125
    right = 55
    top = 105
    bottom = 100
    lane_height = _env_int("GQ_FREQ_LANE_HEIGHT_PX", 430, 220, 1200)
    width = max(base.width, 1400)
    height = max(
        base.height,
        top + bottom + lane_height * max(1, len(cpus)),
    )
    plot_width = width - left - right

    max_ticks = _env_int("GQ_FREQ_MAX_X_TICKS", 24, 4, 200)
    requested_label_ms = _env_int(
        "GQ_FREQ_PLOT_X_LABEL_MS",
        _env_int("GQ_PLOT_X_LABEL_MS", 100, 1, 600000),
        1,
        600000,
    )
    tick_step_ms = _nice_step(
        max_x_ms,
        requested_label_ms,
        max_ticks,
    )

    max_labels = _env_int("GQ_FREQ_MAX_BAR_LABELS", 80, 0, 10000)
    total_bars = sum(len(rows) for rows in intervals_by_cpu.values())
    label_stride = (
        max(1, math.ceil(total_bars / max_labels))
        if max_labels > 0
        else total_bars + 1
    )

    palette = [
        "#4E79A7",
        "#F28E2B",
        "#59A14F",
        "#E15759",
        "#B07AA1",
        "#76B7B2",
    ]

    def x_pos(value_ms: float) -> float:
        return (
            left
            + min(max(value_ms, 0.0), max_x_ms)
            / max_x_ms
            * plot_width
        )

    out = [
        (
            f'<svg xmlns="http://www.w3.org/2000/svg" '
            f'width="{width}" height="{height}" '
            f'viewBox="0 0 {width} {height}">'
        ),
        '<rect width="100%" height="100%" fill="white"/>',
        (
            f'<text x="{width / 2:.1f}" y="34" text-anchor="middle" '
            f'font-family="sans-serif" font-size="24">'
            f'{html.escape(f"GreenQUIC {role} CPU frequency interval bars")}'
            '</text>'
        ),
        (
            f'<text x="{width / 2:.1f}" y="62" text-anchor="middle" '
            f'font-family="sans-serif" font-size="15">'
            'Bar height = frequency; bar width = time held at that frequency'
            '</text>'
        ),
    ]

    plot_bottom = top + lane_height * max(1, len(cpus))
    tick = 0.0

    while tick <= max_x_ms + tick_step_ms * 0.001:
        x = x_pos(tick)
        out.append(
            f'<line x1="{x:.2f}" y1="{top}" x2="{x:.2f}" '
            f'y2="{plot_bottom}" stroke="#dedede" stroke-width="1"/>'
        )
        out.append(
            f'<text x="{x:.2f}" y="{plot_bottom + 34}" '
            f'text-anchor="middle" font-family="monospace" font-size="13">'
            f'{tick:g}</text>'
        )
        tick += tick_step_ms

    bar_counter = 0

    for lane_index, cpu in enumerate(cpus):
        lane_top = top + lane_index * lane_height
        lane_bottom = lane_top + lane_height - 55
        usable_height = lane_height - 95
        color = palette[lane_index % len(palette)]

        out.append(
            f'<rect x="{left}" y="{lane_top}" width="{plot_width}" '
            f'height="{lane_height - 35}" fill="#fafafa" stroke="#aaaaaa"/>'
        )
        out.append(
            f'<text x="{left - 16}" y="{lane_top + 24}" text-anchor="end" '
            f'font-family="sans-serif" font-size="16" font-weight="bold">'
            f'CPU {cpu}</text>'
        )

        for y_index in range(6):
            value = y_max * y_index / 5.0
            y = lane_bottom - value / y_max * usable_height
            out.append(
                f'<line x1="{left}" y1="{y:.2f}" x2="{width - right}" '
                f'y2="{y:.2f}" stroke="#e6e6e6"/>'
            )
            out.append(
                f'<text x="{left - 12}" y="{y + 5:.2f}" text-anchor="end" '
                f'font-family="monospace" font-size="13">{value:.2f}</text>'
            )

        for interval in intervals_by_cpu[cpu]:
            x0 = x_pos(float(interval["start_ms"]))
            x1 = x_pos(float(interval["end_ms"]))
            bar_width = max(1.0, x1 - x0)
            freq_ghz = float(interval["freq_ghz"])
            bar_height = freq_ghz / y_max * usable_height
            y = lane_bottom - bar_height

            out.append(
                f'<rect x="{x0:.2f}" y="{y:.2f}" '
                f'width="{bar_width:.2f}" height="{bar_height:.2f}" '
                f'fill="{color}" stroke="black" stroke-width="0.6"/>'
            )

            if (
                max_labels > 0
                and bar_counter % label_stride == 0
                and bar_width >= 30.0
            ):
                label = f"{freq_ghz:.3f} GHz"
                if interval.get("action"):
                    label += f" | {interval['action']}"

                out.append(
                    f'<text x="{x0 + bar_width / 2:.2f}" '
                    f'y="{max(lane_top + 18, y - 7):.2f}" '
                    f'text-anchor="middle" font-family="sans-serif" '
                    f'font-size="11">{html.escape(label)}</text>'
                )

            bar_counter += 1

        out.append(
            f'<line x1="{left}" y1="{lane_bottom}" '
            f'x2="{width - right}" y2="{lane_bottom}" '
            f'stroke="black" stroke-width="2"/>'
        )

    out.extend([
        (
            f'<text x="{width / 2:.1f}" y="{height - 24}" '
            f'text-anchor="middle" font-family="sans-serif" font-size="17">'
            f'Elapsed time [ms] — bounded labeled step {tick_step_ms:g} ms'
            '</text>'
        ),
        (
            f'<text x="28" y="{height / 2:.1f}" text-anchor="middle" '
            f'font-family="sans-serif" font-size="17" '
            f'transform="rotate(-90 28 {height / 2:.1f})">'
            'Frequency [GHz]</text>'
        ),
        '</svg>',
    ])

    path.write_text("\n".join(out) + "\n", encoding="utf-8")

    return (
        SimpleNamespace(
            width=width,
            height=height,
            tick_ms=tick_step_ms,
            label_ms=tick_step_ms,
            min_px_per_tick=base.min_px_per_tick,
        ),
        intervals_by_cpu,
    )

def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--timeline", type=Path, required=True)
    parser.add_argument("--prefix", type=Path, required=True)
    parser.add_argument("--role", choices=("server", "client"), required=True)
    args = parser.parse_args()

    raw_events, duration_s = read_events(args.timeline)
    events = deduplicate(raw_events)
    args.prefix.parent.mkdir(parents=True, exist_ok=True)
    json_path = Path(str(args.prefix) + ".json")
    csv_path = Path(str(args.prefix) + ".csv")
    list_path = Path(str(args.prefix) + "_lists.txt")
    svg_path = Path(str(args.prefix) + "_timeseries.svg")

    cpus = sorted({int(row["cpu"]) for row in events})

    plot = None
    intervals_by_cpu: dict[int, list[dict[str, Any]]] = {}
    if events:
        plot, intervals_by_cpu = _write_frequency_bar_svg(
            svg_path,
            role=args.role,
            events=events,
            duration_ms=duration_s * 1000.0,
        )

    frequencies = [int(row["freq_khz"]) for row in events]
    output = {
        "schema": "greenquic-frequency-trace-v2",
        "role": args.role,
        "timeline_duration_s": duration_s,
        "event_count_raw": len(raw_events),
        "event_count": len(events),
        "cpus": cpus,
        "min_freq_khz": min(frequencies) if frequencies else None,
        "max_freq_khz": max(frequencies) if frequencies else None,
        "events": events,
        "frequency_intervals_by_cpu": {
            str(cpu): rows for cpu, rows in intervals_by_cpu.items()
        },
        "plot": None if plot is None else {
            "kind": "frequency_interval_bar_chart",
            "width_px": plot.width,
            "height_px": plot.height,
            "x_tick_ms": plot.tick_ms,
            "x_label_ms": plot.label_ms,
            "min_px_per_tick": plot.min_px_per_tick,
        },
        "measurement_note": (
            "Each vertical bar is one deduplicated frequency-residency interval. "
            "Bar height is GHz and bar width is duration. Event timestamps come "
            "from the line-timestamp wrapper; frequency before the first observed "
            "event is not inferred."
        ),
    }
    json_path.write_text(json.dumps(output, indent=2) + "\n", encoding="utf-8")
    with csv_path.open("w", newline="", encoding="utf-8") as handle:
        writer = csv.DictWriter(handle, fieldnames=[
            "elapsed_s", "elapsed_ms", "cpu", "freq_khz", "source", "action"
        ])
        writer.writeheader()
        writer.writerows(events)
    list_path.write_text(
        "frequency_events = " + repr(events) + "\n",
        encoding="utf-8",
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
