#!/usr/bin/env python3
import argparse
import csv
import json
import math
import os
import statistics
import sys
from collections import Counter, defaultdict

# ----------------------------------------------------------------------
# Early skip guard: no matplotlib import before this.
# ----------------------------------------------------------------------

def _arg_value(option):
    try:
        i = sys.argv.index(option)
    except ValueError:
        return None
    if i + 1 >= len(sys.argv):
        return None
    return sys.argv[i + 1]

def _truthy_env(name, default="0"):
    return os.environ.get(name, default).strip().lower() in ("1", "true", "yes", "on")

def _write_placeholder_svg(path, title, lines):
    if not path:
        return
    os.makedirs(os.path.dirname(path), exist_ok=True)
    width = 1600
    height = 400
    y = 40
    svg = [
        f'<svg xmlns="http://www.w3.org/2000/svg" width="{width}" height="{height}">',
        '<rect width="100%" height="100%" fill="white"/>',
        f'<text x="30" y="{y}" font-size="28" font-family="Arial" fill="black">{title}</text>'
    ]
    y += 50
    for line in lines:
        svg.append(f'<text x="30" y="{y}" font-size="22" font-family="Arial" fill="black">{line}</text>')
        y += 34
    svg.append('</svg>')
    with open(path, "w", encoding="utf-8") as f:
        f.write("\n".join(svg))

def _write_skip_summary(summary_path, reason, role):
    if not summary_path:
        return
    os.makedirs(os.path.dirname(summary_path), exist_ok=True)
    with open(summary_path, "w", encoding="utf-8") as f:
        json.dump(
            {
                "role": role,
                "skipped": True,
                "reason": reason,
            },
            f,
            indent=2,
        )

_csv = _arg_value("--csv")
_summary = _arg_value("--summary")
_timeline = _arg_value("--timeline-svg")
_hist = _arg_value("--histogram-svg")
_role = _arg_value("--role") or "unknown"

enabled = _truthy_env("ENABLE_CSTATE_RECORD", "0")

has_rows = False
if _csv and os.path.isfile(_csv):
    try:
        with open(_csv, "r", encoding="utf-8", errors="replace") as f:
            reader = csv.reader(f)
            header = next(reader, None)
            first = next(reader, None)
            has_rows = header is not None and first is not None
    except OSError:
        has_rows = False

if not enabled:
    reason = "ENABLE_CSTATE_RECORD is disabled"
    print(f"[GreenQUIC-Test] Skipping C-state plots: {reason}.")
    _write_skip_summary(_summary, reason, _role)
    _write_placeholder_svg(_timeline, "GreenQUIC C-state timeline skipped", [reason])
    _write_placeholder_svg(_hist, "GreenQUIC C-state histogram skipped", [reason])
    raise SystemExit(0)

if not _csv or not os.path.isfile(_csv):
    reason = "C-state CSV file is missing"
    print(f"[GreenQUIC-Test] Skipping C-state plots: {reason}.")
    _write_skip_summary(_summary, reason, _role)
    _write_placeholder_svg(_timeline, "GreenQUIC C-state timeline skipped", [reason])
    _write_placeholder_svg(_hist, "GreenQUIC C-state histogram skipped", [reason])
    raise SystemExit(0)

if not has_rows:
    reason = "no C-state samples were recorded"
    print(f"[GreenQUIC-Test] Skipping C-state plots: {reason}.")
    _write_skip_summary(_summary, reason, _role)
    _write_placeholder_svg(_timeline, "GreenQUIC C-state timeline skipped", [reason])
    _write_placeholder_svg(_hist, "GreenQUIC C-state histogram skipped", [reason])
    raise SystemExit(0)

# ----------------------------------------------------------------------
# Real plotting starts here.
# ----------------------------------------------------------------------

import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt

# ----------------------------------------------------------------------
# Helpers
# ----------------------------------------------------------------------

def env_int(name, default):
    try:
        return int(os.environ.get(name, str(default)))
    except Exception:
        return default

def env_float(name, default):
    try:
        return float(os.environ.get(name, str(default)))
    except Exception:
        return default

def first_nonempty(row, names):
    for n in names:
        if n in row:
            v = row[n]
            if v is not None and str(v).strip() != "":
                return str(v).strip()
    return None

def parse_float(v, default=0.0):
    if v is None:
        return default
    try:
        return float(str(v).strip())
    except Exception:
        return default

def normalize_state(raw):
    if raw is None:
        return None
    s = str(raw).strip().upper()
    if not s:
        return None

    # Common cases: "6" -> C6, "C6" stays C6, "state 6" -> C6
    digits = "".join(ch for ch in s if ch.isdigit())
    if s.startswith("C") and digits:
        return "C" + digits
    if digits and ("IDLE" in s or "STATE" in s or s.isdigit()):
        return "C" + digits

    if s in ("POLL", "BUSY", "ACTIVE", "C0"):
        return "C0"

    return s

def classify_row(row):
    event_raw = first_nonempty(row, [
        "event", "type", "trace_event", "kind", "action", "phase"
    ])
    state_raw = first_nonempty(row, [
        "state", "cstate", "idle_state", "state_name", "name"
    ])

    event = (event_raw or "").strip().lower()
    state = normalize_state(state_raw)

    duration_us = 0.0
    duration_us = max(duration_us, parse_float(first_nonempty(row, [
        "duration_us", "delta_us", "idle_duration_us",
        "actual_duration_us", "residency_us"
    ]), 0.0))

    if duration_us <= 0.0:
        start_ns = parse_float(first_nonempty(row, ["start_ns", "ts_start_ns", "begin_ns"]), 0.0)
        end_ns = parse_float(first_nonempty(row, ["end_ns", "ts_end_ns", "finish_ns"]), 0.0)
        if end_ns > start_ns > 0.0:
            duration_us = (end_ns - start_ns) / 1000.0

    if "wake" in event or "wakeup" in event or "sched_wakeup" in event:
        return {
            "kind": "WAKEUP",
            "duration_us": 0.0,
            "label": "WAKEUP",
        }

    if state is not None:
        return {
            "kind": "STATE",
            "duration_us": duration_us,
            "label": state,
        }

    if "idle" in event and "exit" not in event and "enter" not in event:
        return {
            "kind": "STATE",
            "duration_us": duration_us,
            "label": "IDLE",
        }

    if "exit" in event:
        return {
            "kind": "EXIT",
            "duration_us": 0.0,
            "label": "IDLE_EXIT",
        }

    if "enter" in event:
        return {
            "kind": "ENTER",
            "duration_us": 0.0,
            "label": "IDLE_ENTER",
        }

    return {
        "kind": "OTHER",
        "duration_us": duration_us,
        "label": "OTHER",
    }

def sort_key(label):
    if label == "WAKEUP":
        return (2, 0, label)
    if label.startswith("C") and label[1:].isdigit():
        return (0, int(label[1:]), label)
    return (1, 0, label)

# ----------------------------------------------------------------------
# Config
# ----------------------------------------------------------------------

COMPACT = max(1, env_int("CSTATE_COMPACT", env_int("Cstate_compact", 500)))
WIDTH_PX = max(1200, env_int("CSTATE_PLOT_WIDTH_PX", 24000))
HEIGHT_PX = max(600, env_int("CSTATE_PLOT_HEIGHT_PX", 3500))
DPI = max(50, env_int("CSTATE_PLOT_DPI", 100))
MAX_X_TICKS = max(4, env_int("CSTATE_MAX_X_TICKS", 24))
ANNOTATE_EVERY = max(1, env_int("CSTATE_ANNOTATE_EVERY", 1))
TITLE_FONTSIZE = env_int("CSTATE_TITLE_FONTSIZE", 20)
LABEL_FONTSIZE = env_int("CSTATE_LABEL_FONTSIZE", 15)
TICK_FONTSIZE = env_int("CSTATE_TICK_FONTSIZE", 12)
LEGEND_FONTSIZE = env_int("CSTATE_LEGEND_FONTSIZE", 12)

# ----------------------------------------------------------------------
# Load CSV
# ----------------------------------------------------------------------

rows = []
with open(_csv, "r", encoding="utf-8", errors="replace", newline="") as f:
    reader = csv.DictReader(f)
    for row in reader:
        rows.append(row)

parsed = [classify_row(r) for r in rows]

state_duration_total = defaultdict(float)
event_count_total = Counter()
wakeups_total = 0

for item in parsed:
    label = item["label"]
    event_count_total[label] += 1
    if item["kind"] == "STATE":
        state_duration_total[label] += item["duration_us"]
    if item["kind"] == "WAKEUP":
        wakeups_total += 1

observed_labels = sorted(set(event_count_total.keys()), key=sort_key)
state_labels = sorted(
    [x for x in observed_labels if x.startswith("C") or x == "IDLE"],
    key=sort_key
)

# ----------------------------------------------------------------------
# Compact into buckets of N events
# ----------------------------------------------------------------------

buckets = []
for start in range(0, len(parsed), COMPACT):
    part = parsed[start:start + COMPACT]
    bucket = {
        "start_index": start,
        "end_index": start + len(part) - 1,
        "counts": Counter(),
        "durations": defaultdict(float),
        "wakeups": 0,
        "total_duration_us": 0.0,
    }

    for item in part:
        label = item["label"]
        bucket["counts"][label] += 1
        if item["kind"] == "STATE":
            bucket["durations"][label] += item["duration_us"]
            bucket["total_duration_us"] += item["duration_us"]
        if item["kind"] == "WAKEUP":
            bucket["wakeups"] += 1

    buckets.append(bucket)

# ----------------------------------------------------------------------
# Colors
# ----------------------------------------------------------------------

base_colors = {
    "C0": "#4c78a8",
    "C1": "#f58518",
    "C1E": "#54a24b",
    "C2": "#e45756",
    "C3": "#72b7b2",
    "C6": "#b279a2",
    "C7": "#ff9da6",
    "C8": "#9d755d",
    "IDLE": "#bab0ac",
    "WAKEUP": "#000000",
    "IDLE_ENTER": "#8cd17d",
    "IDLE_EXIT": "#b6992d",
    "OTHER": "#888888",
}

cmap = plt.get_cmap("tab20")
for idx, label in enumerate(observed_labels):
    if label not in base_colors:
        base_colors[label] = matplotlib.colors.to_hex(cmap(idx % 20))

# ----------------------------------------------------------------------
# Timeline plot: stacked durations per compact bucket + wakeups
# ----------------------------------------------------------------------

fig_w = WIDTH_PX / DPI
fig_h = HEIGHT_PX / DPI

fig, ax = plt.subplots(figsize=(fig_w, fig_h), dpi=DPI)

x = list(range(len(buckets)))
bottom = [0.0] * len(buckets)

for state in state_labels:
    heights = [b["durations"].get(state, 0.0) / 1000.0 for b in buckets]  # ms
    if any(h > 0 for h in heights):
        ax.bar(
            x,
            heights,
            bottom=bottom,
            color=base_colors.get(state, "#999999"),
            edgecolor="black",
            linewidth=0.3,
            width=0.85,
            label=state,
        )
        bottom = [bottom[i] + heights[i] for i in range(len(bottom))]

wake_counts = [b["wakeups"] for b in buckets]
ax2 = ax.twinx()
ax2.plot(
    x,
    wake_counts,
    color=base_colors["WAKEUP"],
    marker="o",
    linestyle="-",
    linewidth=1.5,
    markersize=3,
    label="WAKEUP count",
)

# Total duration annotation above each compact bar
for i, b in enumerate(buckets):
    total_ms = b["total_duration_us"] / 1000.0
    if total_ms <= 0.0:
        continue
    if (i % ANNOTATE_EVERY) != 0:
        continue
    ax.text(
        i,
        total_ms + max(0.02 * max(bottom or [1.0]), 0.1),
        f"{total_ms:.1f} ms",
        ha="center",
        va="bottom",
        fontsize=max(8, TICK_FONTSIZE - 1),
        rotation=90 if len(buckets) > 30 else 0,
    )

tick_step = max(1, math.ceil(len(buckets) / MAX_X_TICKS))
tick_positions = list(range(0, len(buckets), tick_step))
if tick_positions and tick_positions[-1] != len(buckets) - 1:
    tick_positions.append(len(buckets) - 1)

tick_labels = []
for i in tick_positions:
    b = buckets[i]
    total_ms = b["total_duration_us"] / 1000.0
    tick_labels.append(
        f"B{i}\nrows {b['start_index']}-{b['end_index']}\n{total_ms:.1f} ms"
    )

ax.set_xticks(tick_positions)
ax.set_xticklabels(tick_labels, fontsize=TICK_FONTSIZE)
ax.tick_params(axis="y", labelsize=TICK_FONTSIZE)
ax2.tick_params(axis="y", labelsize=TICK_FONTSIZE)

ax.set_xlabel(
    f"Compacted trace buckets ({COMPACT} input rows per bucket)",
    fontsize=LABEL_FONTSIZE,
)
ax.set_ylabel(
    "Idle-state residence duration per bucket (ms)",
    fontsize=LABEL_FONTSIZE,
)
ax2.set_ylabel(
    "Wakeup events per bucket",
    fontsize=LABEL_FONTSIZE,
)

ax.set_title(
    f"GreenQUIC C-state timeline — role={_role} — compact={COMPACT}",
    fontsize=TITLE_FONTSIZE,
)

ax.grid(True, axis="y", linestyle="--", alpha=0.4)

handles1, labels1 = ax.get_legend_handles_labels()
handles2, labels2 = ax2.get_legend_handles_labels()
ax.legend(
    handles1 + handles2,
    labels1 + labels2,
    loc="upper right",
    fontsize=LEGEND_FONTSIZE,
    frameon=True,
)

fig.tight_layout()
os.makedirs(os.path.dirname(_timeline), exist_ok=True)
fig.savefig(_timeline, format="svg")
plt.close(fig)

# ----------------------------------------------------------------------
# Histogram / counts plot
# ----------------------------------------------------------------------

hist_labels = sorted(observed_labels, key=sort_key)
hist_counts = [event_count_total[l] for l in hist_labels]
hist_colors = [base_colors.get(l, "#999999") for l in hist_labels]

fig, ax = plt.subplots(figsize=(fig_w, max(10.0, fig_h * 0.65)), dpi=DPI)
bars = ax.bar(
    range(len(hist_labels)),
    hist_counts,
    color=hist_colors,
    edgecolor="black",
    linewidth=0.4,
)

for i, label in enumerate(hist_labels):
    count = event_count_total[label]
    total_ms = state_duration_total.get(label, 0.0) / 1000.0
    extra = f"\n{total_ms:.1f} ms" if total_ms > 0 else ""
    ax.text(
        i,
        count + max(hist_counts) * 0.01 if hist_counts else 0.1,
        f"{count}{extra}",
        ha="center",
        va="bottom",
        fontsize=max(8, TICK_FONTSIZE - 1),
        rotation=0,
    )

ax.set_xticks(range(len(hist_labels)))
ax.set_xticklabels(hist_labels, rotation=45, ha="right", fontsize=TICK_FONTSIZE)
ax.tick_params(axis="y", labelsize=TICK_FONTSIZE)
ax.set_ylabel("Number of observed events", fontsize=LABEL_FONTSIZE)
ax.set_xlabel("Observed state / event", fontsize=LABEL_FONTSIZE)
ax.set_title(
    f"GreenQUIC C-state / wakeup counts — role={_role}",
    fontsize=TITLE_FONTSIZE,
)
ax.grid(True, axis="y", linestyle="--", alpha=0.4)

legend_items = []
seen = set()
for label in hist_labels:
    if label in seen:
        continue
    seen.add(label)
    legend_items.append(
        matplotlib.patches.Patch(color=base_colors.get(label, "#999999"), label=label)
    )

if legend_items:
    ax.legend(handles=legend_items, loc="upper right", fontsize=LEGEND_FONTSIZE, frameon=True)

fig.tight_layout()
os.makedirs(os.path.dirname(_hist), exist_ok=True)
fig.savefig(_hist, format="svg")
plt.close(fig)

# ----------------------------------------------------------------------
# Summary JSON
# ----------------------------------------------------------------------

bucket_durations_ms = [b["total_duration_us"] / 1000.0 for b in buckets]
summary = {
    "role": _role,
    "skipped": False,
    "rows": len(rows),
    "compact_size_rows": COMPACT,
    "bucket_count": len(buckets),
    "observed_labels": hist_labels,
    "state_labels": state_labels,
    "event_counts": dict(event_count_total),
    "state_total_duration_us": dict(state_duration_total),
    "wakeups_total": wakeups_total,
    "bucket_total_duration_ms": bucket_durations_ms,
    "bucket_duration_stats_ms": {
        "min": min(bucket_durations_ms) if bucket_durations_ms else 0.0,
        "mean": statistics.mean(bucket_durations_ms) if bucket_durations_ms else 0.0,
        "median": statistics.median(bucket_durations_ms) if bucket_durations_ms else 0.0,
        "max": max(bucket_durations_ms) if bucket_durations_ms else 0.0,
    },
    "plot_config": {
        "width_px": WIDTH_PX,
        "height_px": HEIGHT_PX,
        "dpi": DPI,
        "max_x_ticks": MAX_X_TICKS,
        "annotate_every": ANNOTATE_EVERY,
    },
}

os.makedirs(os.path.dirname(_summary), exist_ok=True)
with open(_summary, "w", encoding="utf-8") as f:
    json.dump(summary, f, indent=2)

print(
    f"[GreenQUIC-Test] C-state charts generated: "
    f"compact={COMPACT}, buckets={len(buckets)}, wakeups={wakeups_total}"
)
