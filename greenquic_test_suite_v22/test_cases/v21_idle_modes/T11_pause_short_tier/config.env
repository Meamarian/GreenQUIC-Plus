REQUIRES_INPROCESS_CLIENT="${REQUIRES_INPROCESS_CLIENT:-0}"
IDLE_DURATION_S="${IDLE_DURATION_S:-10}"
REQUEST_PATHS="${REQUEST_PATHS:-}"

# Conservative policy defaults. Empty thresholds intentionally count empty pulls.
RX_EMPTY_POLLS="${RX_EMPTY_POLLS:-64}"
