VALIDATE_IDLE_EVIDENCE="${VALIDATE_IDLE_EVIDENCE:-1}"
REQUIRE_ACTIONS="${REQUIRE_ACTIONS:-optimized_pause_short}"
MIN_FIELDS="${MIN_FIELDS:-cstate_attempt:1,cstate_ok:1,cstate_actual_total_us:1}"
