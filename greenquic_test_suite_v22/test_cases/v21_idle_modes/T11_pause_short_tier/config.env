# Per-test configuration for T0_1: Idle DPDK polling with no client traffic
TEST_ID='T11'
TEST_TITLE='V21 bounded optimized-pause short tier'
WORKLOAD_KIND="${WORKLOAD_KIND:-idle_no_client}"
