FULL_BURST_COUNT="${FULL_BURST_COUNT:-8}"
FREQ_UP_PERIOD_US="${FREQ_UP_PERIOD_US:-500}"
FREQ_DOWN_PERIOD_US="${FREQ_DOWN_PERIOD_US:-5000}"
FREQ_MIN_IDLE_US="${FREQ_MIN_IDLE_US:-1000}"
ENABLE_FREQ="${ENABLE_FREQ:-1}"
ENABLE_SLEEP="${ENABLE_SLEEP:-1}"


# Final V18 separated-signal policy for this testcase.
PRESSURE_SCALE="${PRESSURE_SCALE:-1000}"
RX_BURST_RISE_ALPHA_PERMILLE="${RX_BURST_RISE_ALPHA_PERMILLE:-500}"
RX_BURST_FALL_ALPHA_PERMILLE="${RX_BURST_FALL_ALPHA_PERMILLE:-500}"
RX_QUEUE_RISE_ALPHA_PERMILLE="${RX_QUEUE_RISE_ALPHA_PERMILLE:-1000}"
RX_QUEUE_FALL_ALPHA_PERMILLE="${RX_QUEUE_FALL_ALPHA_PERMILLE:-250}"
TX_BURST_RISE_ALPHA_PERMILLE="${TX_BURST_RISE_ALPHA_PERMILLE:-500}"
TX_BURST_FALL_ALPHA_PERMILLE="${TX_BURST_FALL_ALPHA_PERMILLE:-500}"
TX_RING_RISE_ALPHA_PERMILLE="${TX_RING_RISE_ALPHA_PERMILLE:-1000}"
TX_RING_FALL_ALPHA_PERMILLE="${TX_RING_FALL_ALPHA_PERMILLE:-250}"

FULL_BURST_FLOOR="${FULL_BURST_FLOOR:-0}"
ACK_CLIENT_FLOOR="${ACK_CLIENT_FLOOR:-600}"
ACK_OTHER_FLOOR="${ACK_OTHER_FLOOR:-550}"
ACK_RX_HARDMAX_THRESHOLD="${ACK_RX_HARDMAX_THRESHOLD:-900}"
ENABLE_ACK_RX_HARDMAX="${ENABLE_ACK_RX_HARDMAX:-1}"
ACK_BLOCKS_SLEEP="${ACK_BLOCKS_SLEEP:-1}"

CWND_GROWTH_NO_WORK_FLOOR="${CWND_GROWTH_NO_WORK_FLOOR:-550}"
CWND_GROWTH_WORK_FLOOR="${CWND_GROWTH_WORK_FLOOR:-600}"
CWND_GROWTH_PHYSICAL_THRESHOLD="${CWND_GROWTH_PHYSICAL_THRESHOLD:-250}"
CWND_GROWTH_BLOCKS_SLEEP="${CWND_GROWTH_BLOCKS_SLEEP:-1}"

RECOVERY_FLOOR="${RECOVERY_FLOOR:-750}"
RECOVERY_HARDMAX_PHYSICAL_THRESHOLD="${RECOVERY_HARDMAX_PHYSICAL_THRESHOLD:-600}"
ENABLE_RECOVERY_HARDMAX="${ENABLE_RECOVERY_HARDMAX:-1}"
RECOVERY_BLOCKS_SLEEP="${RECOVERY_BLOCKS_SLEEP:-1}"

BLOCKED_RX_FLOOR="${BLOCKED_RX_FLOOR:-0}"
BLOCKED_SLEEP_GUARD_LEVEL="${BLOCKED_SLEEP_GUARD_LEVEL:-0}"
ACTIVE_TRANSFER_SLEEP_MIN_LEVEL="${ACTIVE_TRANSFER_SLEEP_MIN_LEVEL:-4}"
ENABLE_PHYSICAL_HARDMAX="${ENABLE_PHYSICAL_HARDMAX:-1}"

FREQ_PERIOD_US="${FREQ_PERIOD_US:-100000}"
NO_SLEEP_IF_TX_RING_NOT_EMPTY="${NO_SLEEP_IF_TX_RING_NOT_EMPTY:-1}"
TX_RING_PROTECT_UP="${TX_RING_PROTECT_UP:-1}"
SLEEP_SHORT_MIN_LEVEL="${SLEEP_SHORT_MIN_LEVEL:-2}"
SLEEP_DATA_MIN_LEVEL="${SLEEP_DATA_MIN_LEVEL:-4}"
SLEEP_DEEP_MIN_LEVEL="${SLEEP_DEEP_MIN_LEVEL:-8}"
ACK_SLEEP_US="${ACK_SLEEP_US:-1}"
DATA_SLEEP_US="${DATA_SLEEP_US:-1}"
MAX_SLEEP_US="${MAX_SLEEP_US:-1}"


# Final V21 selectable-idle testcase controls.
IDLE_MODE="${IDLE_MODE:-pause}"
IDLE_FALLBACK="${IDLE_FALLBACK:-fail}"
ENABLE_CSTATE_IDLE="${ENABLE_CSTATE_IDLE:-1}"
CSTATE_MIN_IDLE_US="${CSTATE_MIN_IDLE_US:-1000}"
CSTATE_MIN_LEVEL="${CSTATE_MIN_LEVEL:-4}"
CSTATE_DEEP_MIN_LEVEL="${CSTATE_DEEP_MIN_LEVEL:-1000000}"
CSTATE_WAIT_US="${CSTATE_WAIT_US:-50}"
CSTATE_DEEP_WAIT_US="${CSTATE_DEEP_WAIT_US:-300}"
CSTATE_MAX_WAIT_US="${CSTATE_MAX_WAIT_US:-300}"
CSTATE_TX_OWNER_MAX_WAIT_US="${CSTATE_TX_OWNER_MAX_WAIT_US:-50}"
