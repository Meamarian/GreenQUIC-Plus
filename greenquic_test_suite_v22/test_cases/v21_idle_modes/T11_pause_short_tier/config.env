SERVER_PROFILE="${SERVER_PROFILE:-server_download}"
CLIENT_PROFILE="${CLIENT_PROFILE:-client_download}"
MSQUIC_EXECUTION_PROFILE="${MSQUIC_EXECUTION_PROFILE:-max_throughput}"
ENABLE_MULTICORE="${ENABLE_MULTICORE:-0}"
GAP_US="${GAP_US:-0}"
REPETITIONS="${REPETITIONS:-1}"
