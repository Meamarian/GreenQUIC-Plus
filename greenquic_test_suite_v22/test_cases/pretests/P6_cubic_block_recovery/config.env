# P6 keeps the proven P5 workload/power defaults read-only and overrides only
# experiment identity and payload. P5 itself is never modified.
P6_HERE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
source "$P6_HERE/../P5_repeated_8GiB_downloads/config.env"

TEST_ID='P6'
TEST_TITLE='CUBIC CWND-blocked and recovery under deterministic network loss'
REQUEST_PATH="${REQUEST_PATH:-/file_16G.bin}"
REQUEST_PATHS="${REQUEST_PATHS:-$REQUEST_PATH}"
PAYLOAD_BYTES="${PAYLOAD_BYTES:-17179869184}"
DOWNLOADS_PER_RUN="${DOWNLOADS_PER_RUN:-5}"
GAP_US="${GAP_US:-5000000}"

# P6 impairment is disabled unless explicitly enabled by the run command.
GQ_P6_DROP_EVERY_N="${GQ_P6_DROP_EVERY_N:-0}"
GQ_P6_DROP_START_AFTER="${GQ_P6_DROP_START_AFTER:-10000}"
