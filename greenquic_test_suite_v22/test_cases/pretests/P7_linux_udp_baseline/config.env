# P7 Linux UDP baseline.
# Defaults are intentionally goodput/high-performance oriented while preserving
# the same CPU mapping used for the P5 comparison. Every setting remains
# overrideable through the environment or run_matrix_from_idex.sh options.
TEST_ID='P7'
TEST_TITLE='Linux kernel UDP datapath baseline with repeated 8 GiB downloads'
WORKLOAD_KIND="${WORKLOAD_KIND:-multi_stream_single_connection}"
MSQUIC_EXECUTION_PROFILE="${MSQUIC_EXECUTION_PROFILE:-max_throughput}"

DOWNLOADS_PER_RUN="${DOWNLOADS_PER_RUN:-5}"
GAP_US="${GAP_US:-5000000}"
MATRIX_REPETITIONS="${MATRIX_REPETITIONS:-5}"
REQUEST_PATH="${REQUEST_PATH:-/file_8G.bin}"
PAYLOAD_BYTES="${PAYLOAD_BYTES:-8589934592}"
CLIENT_TIMEOUT_MS="${CLIENT_TIMEOUT_MS:-600000}"

# Same endpoint addressing as the DPDK P5 experiment.
P7_SERVER_IP="${P7_SERVER_IP:-192.168.100.1}"
P7_CLIENT_IP="${P7_CLIENT_IP:-192.168.100.2}"
P7_PREFIX_LEN="${P7_PREFIX_LEN:-24}"
P7_MTU="${P7_MTU:-1500}"
P7_PORT="${P7_PORT:-4433}"

# Goodput-oriented CPU mapping relative to P5 single-DPDK-core mode:
#   P5: CPU19 = DPDK; CPUs21-24 = MsQuic workers.
#   P7: CPU19 = NIC IRQ/NAPI/softirq target; CPUs21-24 = MsQuic workers.
P7_DATAPLANE_CPU="${P7_DATAPLANE_CPU:-19}"
P7_QUIC_CPUS="${P7_QUIC_CPUS:-21,22,23,24}"
P7_PIN_IRQ="${P7_PIN_IRQ:-1}"
P7_PIN_QUIC="${P7_PIN_QUIC:-1}"
P7_DISABLE_RPS="${P7_DISABLE_RPS:-1}"

# NIC offload profile:
#   on     = goodput/high-performance default: request common checksum,
#            GRO/GSO and UDP segmentation features where supported
#   native = leave the kernel/NIC state unchanged
#   off    = request those NIC features off where changeable
# The CLI also accepts "paper", which maps the underlying profile to native and
# then applies the stricter GSO/GRO sequence from the comparison paper artifact.
P7_NIC_OFFLOAD_PROFILE="${P7_NIC_OFFLOAD_PROFILE:-on}"
P7_PAPER_OFFLOADS="${P7_PAPER_OFFLOADS:-0}"

# Optional Linux-network reproducibility knobs. Zero means preserve/native.
# The paper-style values are 6815744 bytes for rmem/wmem and 1 combined channel.
P7_UDP_RMEM_BYTES="${P7_UDP_RMEM_BYTES:-0}"
P7_UDP_WMEM_BYTES="${P7_UDP_WMEM_BYTES:-0}"
P7_COMBINED_CHANNELS="${P7_COMBINED_CHANNELS:-0}"

# MsQuic keeps its stock Linux UDP segmentation/coalescing capability probe.
# The detected features are logged in every client/server run.

# Measurement defaults. Keep only measurements needed for direct P5 comparison:
# app/timing logs, RAPL, CPU frequency, CPU C-state and control-phase markers.
# CPU19 only is the strict apples-to-apples C-state/frequency baseline against P5.
# Set P7_RECORD_QUIC_CPUS=1 only for a separate diagnostic run.
ENABLE_RECORD="${ENABLE_RECORD:-1}"
P7_RECORD_CPUS="${P7_RECORD_CPUS:-19}"
P7_RECORD_QUIC_CPUS="${P7_RECORD_QUIC_CPUS:-0}"
P7_RAPL_INTERVAL_MS="${P7_RAPL_INTERVAL_MS:-6}"
P7_RAPL_SMOOTH_SAMPLES="${P7_RAPL_SMOOTH_SAMPLES:-3}"
# Frequency recording default: 1 ms for both P5 and P7 measurements.
P7_FREQ_INTERVAL_MS="${P7_FREQ_INTERVAL_MS:-1}"
P7_REQUIRE_RAPL="${P7_REQUIRE_RAPL:-1}"

# Nonessential Linux network diagnostics are OFF for normal measurements.
# When 0, P7 does NOT save ethtool statistics, link/channel dumps,
# /proc/interrupts, /proc/softirqs, softnet_stat, or before/after net snapshots.
# Tiny state needed to restore settings changed by P7 is still saved.
P7_SAVE_NETWORK_DIAGNOSTICS="${P7_SAVE_NETWORK_DIAGNOSTICS:-0}"

# Deterministic connected idle windows, matching the recent P5 controller.
P7_PRE_COOLDOWN_SECONDS="${P7_PRE_COOLDOWN_SECONDS:-5}"
P7_POST_COOLDOWN_SECONDS="${P7_POST_COOLDOWN_SECONDS:-5}"
P7_BETWEEN_RUNS_SECONDS="${P7_BETWEEN_RUNS_SECONDS:-5}"

# Goodput-oriented testbed hygiene.
P7_STOP_IRQBALANCE="${P7_STOP_IRQBALANCE:-1}"
P7_RESTORE_DPDK_AFTER_RUN="${P7_RESTORE_DPDK_AFTER_RUN:-1}"
