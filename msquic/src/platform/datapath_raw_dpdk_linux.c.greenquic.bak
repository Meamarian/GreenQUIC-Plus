}

_IRQL_requires_max_(PASSIVE_LEVEL)
void
CxPlatDpRawAssignQueue(
        _In_ CXPLAT_INTERFACE* Interface,
        _Inout_ CXPLAT_ROUTE* Route
)
{
    Route->Queue = Interface;
}

_IRQL_requires_max_(DISPATCH_LEVEL)
const CXPLAT_INTERFACE*
CxPlatDpRawGetInterfaceFromQueue(
        _In_ const void* Queue
)
{
    return (const CXPLAT_INTERFACE*)Queue;
}

static
void
CxPlatDpdkRx(
        _In_ DPDK_DATAPATH* Dpdk,
        _In_ DPDK_INTERFACE* Interface
)
{
    void* Buffers[Dpdk->RxBurstSize];
    const uint16_t BuffersCount =
            rte_eth_rx_burst(Interface->Port, 0, (struct rte_mbuf**)Buffers, Dpdk->RxBurstSize);
    if (unlikely(BuffersCount == 0)) {
        return;
    }
    Dpdk->RxCounter += BuffersCount;

    DPDK_RX_PACKET Packet = {0}; // Working space
    Packet.RecvData.Route = &Packet.RouteStorage;
    Packet.RecvData.Route->Queue = Interface;

    uint16_t PacketCount = 0;
    for (uint16_t i = 0; i < BuffersCount; i++) {
        struct rte_mbuf* Buffer = (struct rte_mbuf*)Buffers[i];
        Packet.RecvData.Buffer = NULL;
        if ((Buffer->ol_flags & (RTE_MBUF_F_RX_IP_CKSUM_BAD | RTE_MBUF_F_RX_L4_CKSUM_BAD)) == 0) {
            CxPlatDpRawParseEthernet(
                    (CXPLAT_DATAPATH*)Dpdk,
                    &Packet.RecvData,
                    ((uint8_t*)Buffer->buf_addr) + Buffer->data_off,
                    Buffer->pkt_len);
            //
            // The route has been filled in with the packet's src/dst IP and ETH addresses, so
            // mark it resolved. This allows stateless sends to be issued without performing
            // a route lookup.
            //
            Packet.RecvData.Route->State = RouteResolved;
        } else {
            QuicTraceEvent(
                    LibraryErrorStatus,
                    "[ lib] ERROR, %u, %s.",
                    Buffer->ol_flags,
                    "L3/L4 checksum incorrect");
            CXPLAT_DBG_ASSERT(
                    Interface->OffloadStatus.Receive.NetworkLayerXsum != 0 ||
                    Interface->OffloadStatus.Receive.TransportLayerXsum != 0);
        }

        DPDK_RX_PACKET* NewPacket;
        if (likely(Packet.RecvData.Buffer)) {
            uint32_t RetryCount = 0;
            do {
                NewPacket = CxPlatPoolAlloc(&Dpdk->AdditionalInfoPool);
            } while (NewPacket == NULL && ++RetryCount < 10);
            if (NewPacket == NULL) {
                QuicTraceEvent(
                        AllocFailure,
                        "Allocation of '%s' failed. (%llu bytes)",
                        "DPDK_RX_PACKET",
                        0);
                goto Exit;
            }

            CxPlatCopyMemory(NewPacket, &Packet, sizeof(DPDK_RX_PACKET));
            NewPacket->RecvData.Allocated = TRUE;
            NewPacket->Mbuf = Buffer;
            NewPacket->OwnerPool = &Dpdk->AdditionalInfoPool;
            NewPacket->RecvData.Route = &NewPacket->RouteStorage;
            NewPacket->RecvData.DatapathType = NewPacket->RecvData.Route->DatapathType = CXPLAT_DATAPATH_TYPE_RAW;
            Buffers[PacketCount++] = &NewPacket->RecvData;
        } else {
            printf("Packet.Buffer not set!\n");
            Exit:
            rte_pktmbuf_free(Buffer);
        }
    }

    if (likely(PacketCount)) {
        CxPlatDpRawRxEthernet((CXPLAT_DATAPATH_RAW*)Dpdk, (CXPLAT_RECV_DATA**)Buffers, PacketCount);
    }
}

_IRQL_requires_max_(DISPATCH_LEVEL)
void
CxPlatDpRawRxFree(
        _In_opt_ const CXPLAT_RECV_DATA* PacketChain
)
{
    while (PacketChain) {
        const DPDK_RX_PACKET* Packet =
            CXPLAT_CONTAINING_RECORD(PacketChain, DPDK_RX_PACKET, RecvData);
        PacketChain = PacketChain->Next;
        rte_pktmbuf_free(Packet->Mbuf);
        CxPlatPoolFree(Packet->OwnerPool, (void*)Packet);
    }
}

_IRQL_requires_max_(DISPATCH_LEVEL)
CXPLAT_SEND_DATA*
CxPlatDpRawTxAlloc(
        _In_ CXPLAT_SOCKET_RAW* Socket,
        _Inout_ CXPLAT_SEND_CONFIG* Config
)
{
    DPDK_DATAPATH* Dpdk = (DPDK_DATAPATH*)Socket->RawDatapath;
    DPDK_TX_PACKET* Packet = CxPlatPoolAlloc(&Dpdk->AdditionalInfoPool);
    QUIC_ADDRESS_FAMILY Family = QuicAddrGetFamily(&Config->Route->RemoteAddress);
    DPDK_INTERFACE* Interface = (DPDK_INTERFACE*)Config->Route->Queue;

    if (likely(Packet)) {
        Packet->Interface = Interface;
        Packet->Mbuf = rte_pktmbuf_alloc(Interface->TxMemoryPool);
        if (likely(Packet->Mbuf)) {
            HEADER_BACKFILL HeaderFill = CxPlatDpRawCalculateHeaderBackFill(Family, Socket->UseTcp);
            Packet->Dpdk = Dpdk;
            Packet->Buffer.Length = Config->MaxPacketSize;
            Packet->Mbuf->data_off = 0;
            Packet->Buffer.Buffer = ((uint8_t*)Packet->Mbuf->buf_addr) + HeaderFill.AllLayer;
            Packet->Mbuf->l2_len = HeaderFill.LinkLayer;
            Packet->Mbuf->l3_len = HeaderFill.NetworkLayer;
            Packet->DatapathType = Config->Route->DatapathType = CXPLAT_DATAPATH_TYPE_RAW;
        } else {
            CxPlatPoolFree(&Dpdk->AdditionalInfoPool, Packet);
            Packet = NULL;
            QuicTraceEvent(
                    LibraryError,
                    "[ lib] ERROR, %s.",
                    "Failed to allocate mbuf in TxMemoryPool");
        }
    }
    return (CXPLAT_SEND_DATA*)Packet;
}

_IRQL_requires_max_(DISPATCH_LEVEL)
void
CxPlatDpRawTxFree(
        _In_ CXPLAT_SEND_DATA* SendData
)
{
    DPDK_TX_PACKET* Packet = (DPDK_TX_PACKET*)SendData;
    rte_pktmbuf_free(Packet->Mbuf);
    CxPlatPoolFree(&Packet->Dpdk->AdditionalInfoPool, SendData);
}

_IRQL_requires_max_(DISPATCH_LEVEL)
void
CxPlatDpRawTxEnqueue(
        _In_ CXPLAT_SEND_DATA* SendData
)
{
    DPDK_TX_PACKET* Packet = (DPDK_TX_PACKET*)SendData;
    DPDK_INTERFACE* Interface = Packet->Interface;
    Packet->Mbuf->data_len = (uint16_t)Packet->Buffer.Length;
    //Packet->Mbuf->ol_flags = RTE_MBUF_F_TX_IPV4 | RTE_MBUF_F_TX_IP_CKSUM | RTE_MBUF_F_TX_UDP_CKSUM;

    DPDK_DATAPATH* Dpdk = Packet->Dpdk;
    if (unlikely(rte_ring_enqueue(Interface->TxRingBuffer, Packet->Mbuf) != 0)) {
        rte_pktmbuf_free(Packet->Mbuf);
        QuicTraceEvent(
                LibraryError,
                "[ lib] ERROR, %s.",
                "No room in DPDK TX ring buffer");
    } else {
        QuicTraceEvent(
                DatapathTxEnqueue,
                "[data] TX packet (%u bytes) enqueued in ring (now %u entries).",
                Packet->Mbuf->data_len,
                rte_ring_count(Interface->TxRingBuffer));
    }
    Dpdk->TxEnqueueCounter++; // increase in any case, even if packet was dropped

    CxPlatPoolFree(&Dpdk->AdditionalInfoPool, Packet);
}

static
void
CxPlatDpdkTx(
        _In_ DPDK_DATAPATH* Dpdk,
        _In_ DPDK_INTERFACE* Interface
)
{
    struct rte_mbuf* Buffers[Dpdk->TxBurstSize];
    const uint16_t BufferCount =
            (uint16_t)rte_ring_dequeue_burst(
                    Interface->TxRingBuffer, (void**)Buffers, Dpdk->TxBurstSize, NULL);
    if (unlikely(BufferCount == 0)) {
        return;
    }

    QuicTraceEvent(
            DatapathTxDequeue,
            "[data] %u packets dequeued from TX ring (now %u entries).",
            BufferCount,
            rte_ring_count(Interface->TxRingBuffer));

    if (!Dpdk->Interface.OffloadStatus.Transmit.Lockfree) {
        CxPlatLockAcquire(&Interface->TxLock);
    }
    const uint16_t TxCount = rte_eth_tx_burst(Interface->Port, 0, Buffers, BufferCount);
    if (!Dpdk->Interface.OffloadStatus.Transmit.Lockfree) {
        CxPlatLockRelease(&Interface->TxLock);
    }
    Dpdk->TxCounter += TxCount;
    if (unlikely(TxCount < BufferCount)) {
        for (uint16_t buf = TxCount; buf < BufferCount; buf++) {
            rte_pktmbuf_free(Buffers[buf]);
        }
        QuicTraceEvent(
                LibraryError,
                "[ lib] ERROR, %s.",
                "DPDK: rte_eth_tx_burst() failed to store all packets to send in the NIC's TX descriptors.");
    }
}

static
int
CxPlatDpdkRxWorkerThread(
        _In_ void* Context
)
{
    DPDK_DATAPATH* Dpdk = (DPDK_DATAPATH*)Context;
    const uint16_t Core = (uint16_t)rte_lcore_id();
    CXPLAT_LIST_ENTRY* Entry;

    CxPlatRefIncrement(&Dpdk->RefCount);
    printf("Core %u worker running...\n", Core);
    for (Entry = Dpdk->Interfaces.Flink; Entry != &Dpdk->Interfaces; Entry = Entry->Flink) {
        if (rte_eth_dev_socket_id(Dpdk->Interface.Port) > 0 &&
            rte_eth_dev_socket_id(Dpdk->Interface.Port) != (int)rte_socket_id()) {
            printf("\nWARNING, port %u is on remote NUMA node to polling thread.\n"
                   "\tPerformance will not be optimal.\n\n",
                   Dpdk->Interface.Port);
        }
    }

    while (likely(Dpdk->Running)) {
        for (Entry = Dpdk->Interfaces.Flink; Entry != &Dpdk->Interfaces; Entry = Entry->Flink) {
            DPDK_INTERFACE* Interface = CXPLAT_CONTAINING_RECORD(Entry, DPDK_INTERFACE, Link);
            CxPlatDpdkRx(Dpdk, Interface);
        }
    }
    CxPlatRefDecrement(&Dpdk->RefCount);

    printf("PacketsRecv: %lu\n", Dpdk->RxCounter);

    return 0;
}

static
int
CxPlatDpdkTxWorkerThread(
        _In_ void* Context
)
{
    DPDK_DATAPATH* Dpdk = (DPDK_DATAPATH*)Context;
    const uint16_t Core = (uint16_t)rte_lcore_id();
    CXPLAT_LIST_ENTRY* Entry;

    CxPlatRefIncrement(&Dpdk->RefCount);
    printf("Core %u worker running...\n", Core);
    for (Entry = Dpdk->Interfaces.Flink; Entry != &Dpdk->Interfaces; Entry = Entry->Flink) {
        if (rte_eth_dev_socket_id(Dpdk->Interface.Port) > 0 &&
            rte_eth_dev_socket_id(Dpdk->Interface.Port) != (int)rte_socket_id()) {
            printf("\nWARNING, port %u is on remote NUMA node to polling thread.\n"
                   "\tPerformance will not be optimal.\n\n",
                   Dpdk->Interface.Port);
        }
    }

    while (likely(Dpdk->Running)) {
        for (Entry = Dpdk->Interfaces.Flink; Entry != &Dpdk->Interfaces; Entry = Entry->Flink) {
            DPDK_INTERFACE* Interface = CXPLAT_CONTAINING_RECORD(Entry, DPDK_INTERFACE, Link);
            CxPlatDpdkTx(Dpdk, Interface);
        }
    }
    CxPlatRefDecrement(&Dpdk->RefCount);

    printf("PacketsSent: %lu\n", Dpdk->TxCounter);
    printf("PacketsTriedToSend: %lu\n", Dpdk->TxEnqueueCounter);

    return 0;
}

static
int
CxPlatDpdkRxTxWorkerThread(
        _In_ void* Context
)
{
    DPDK_DATAPATH* Dpdk = (DPDK_DATAPATH*)Context;
    const uint16_t Core = (uint16_t)rte_lcore_id();
    CXPLAT_LIST_ENTRY* Entry;

    CxPlatRefIncrement(&Dpdk->RefCount);
    printf("Core %u worker running...\n", Core);
    for (Entry = Dpdk->Interfaces.Flink; Entry != &Dpdk->Interfaces; Entry = Entry->Flink) {
        if (rte_eth_dev_socket_id(Dpdk->Interface.Port) > 0 &&
            rte_eth_dev_socket_id(Dpdk->Interface.Port) != (int)rte_socket_id()) {
            printf("\nWARNING, port %u is on remote NUMA node to polling thread.\n"
                   "\tPerformance will not be optimal.\n\n",
                   Dpdk->Interface.Port);
        }
    }

    while (likely(Dpdk->Running)) {
        for (Entry = Dpdk->Interfaces.Flink; Entry != &Dpdk->Interfaces; Entry = Entry->Flink) {
            DPDK_INTERFACE* Interface = CXPLAT_CONTAINING_RECORD(Entry, DPDK_INTERFACE, Link);
            CxPlatDpdkRx(Dpdk, Interface);
            CxPlatDpdkTx(Dpdk, Interface);
        }
    }
    CxPlatRefDecrement(&Dpdk->RefCount);

    printf("PacketsRecv: %lu\n", Dpdk->RxCounter);
    printf("PacketsSent: %lu\n", Dpdk->TxCounter);
    printf("PacketsTriedToSend: %lu\n", Dpdk->TxEnqueueCounter);

    return 0;
}

void
CxPlatDpRawSendArpReply(
        _In_ const CXPLAT_DATAPATH* Datapath,
        _In_ const ARP_HEADER* Request
)
{
    const DPDK_DATAPATH* Dpdk = (const DPDK_DATAPATH*)Datapath;
    const DPDK_INTERFACE* Interface = &Dpdk->Interface;
    struct rte_mbuf* Buffer;
    ETHERNET_HEADER* Ethernet;
    ARP_HEADER* Reply;

    if (Request->TargetProtocolAddr != Interface->LocalIp.Ipv4.sin_addr.s_addr) {
        QuicTraceEvent(
                DatapathErrorStatus,
                "[data][%p] ERROR, %u, %s.",
                Datapath,
                0,
                "ARP request has wrong target protocol address");
        return;
    }

    Buffer = rte_pktmbuf_alloc(Interface->TxMemoryPool);
    if (likely(Buffer)) {
        Buffer->data_off = 0;
        Buffer->data_len = sizeof(ETHERNET_HEADER) + sizeof(ARP_HEADER);
        Buffer->l2_len = sizeof(ETHERNET_HEADER);
        Buffer->l3_len = sizeof(ARP_HEADER);

        Ethernet = Buffer->buf_addr;
        Reply = (ARP_HEADER*)Ethernet->Data;

        CxPlatCopyMemory(Ethernet->Destination, Interface->PeerPhysicalAddress, sizeof(Ethernet->Destination));
        CxPlatCopyMemory(Ethernet->Source, Interface->PhysicalAddress, sizeof(Ethernet->Source));
        Ethernet->Type = ETHERNET_TYPE_ARP;

        Reply->HardwareType = ARP_HARDWARE_TYPE_ETHERNET;
        Reply->ProtocolType = ETHERNET_TYPE_IPV4;
        Reply->HardwareAddrLength = sizeof(Reply->SenderHardwareAddr);
        Reply->ProtocolAddrLength = sizeof(Reply->SenderProtocolAddr);
        Reply->Operation = ARP_OPERATION_REPLY;
        CxPlatCopyMemory(Reply->SenderHardwareAddr, Interface->PhysicalAddress, sizeof(Reply->SenderHardwareAddr));
        CxPlatCopyMemory(Reply->TargetHardwareAddr, Request->SenderHardwareAddr, sizeof(Reply->TargetHardwareAddr));
        Reply->SenderProtocolAddr = Interface->LocalIp.Ipv4.sin_addr.s_addr;
        Reply->TargetProtocolAddr = Request->SenderProtocolAddr;

        const uint16_t TxCount = rte_eth_tx_burst(Interface->Port, 0, &Buffer, 1);
        if (TxCount != 1) {
            QuicTraceEvent(
                    DatapathErrorStatus,
                    "[data][%p] ERROR, %u, %s.",
                    Datapath,
                    0,
                    "failed to send ARP reply");
            rte_pktmbuf_free(Buffer);
            return;
        }
    } else {
        QuicTraceEvent(
                LibraryError,
                "[ lib] ERROR, %s.",
                "Failed to allocate mbuf for ARP reply in TxMemoryPool");
    }
}

void
RawDataPathProcessCqe(
    _In_ CXPLAT_CQE* Cqe
)
{
    UNREFERENCED_PARAMETER(Cqe);
}
